{
  "rules": {
    "games": {
      "$roomId": {
        "meta": {
          ".read": "auth != null",
          "hostUid": {
            ".write": "auth != null && (!data.exists() || auth.uid === data.val())"
          },
          "presidentUid": {
            ".write": "auth != null && auth.uid === data.parent().child('hostUid').val()"
          },
          "chancellorCandidateUid": {
            ".write": "auth != null && (auth.uid === data.parent().child('presidentUid').val() || auth.uid === data.parent().child('hostUid').val())"
          },
          "chancellorUid": {
            ".write": "auth != null && auth.uid === data.parent().child('hostUid').val()"
          },
          "presidentUidLast": {
            ".write": "auth != null && auth.uid === data.parent().child('hostUid').val()"
          },
          "phase": {
            ".write": "auth != null && auth.uid === data.parent().child('hostUid').val()"
          },
          "playerOrder": {
            ".write": "auth != null && auth.uid === data.parent().child('hostUid').val()"
          },
          "electionTracker": {
            ".write": "auth != null && auth.uid === data.parent().child('hostUid').val()",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
          },
          "liberalTrack": {
            ".write": "auth != null && auth.uid === data.parent().child('hostUid').val()",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
          },
          "fascistTrack": {
            ".write": "auth != null && auth.uid === data.parent().child('hostUid').val()",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6"
          },
          "vetoUnlocked": {
            ".write": "auth != null && auth.uid === data.parent().child('hostUid').val()"
          },
          "winner": {
            ".write": "auth != null && auth.uid === data.parent().child('hostUid').val()"
          },
          "winReason": {
            ".write": "auth != null && auth.uid === data.parent().child('hostUid').val()"
          },
          "pendingPower": {
            ".write": "auth != null && auth.uid === data.parent().child('hostUid').val()"
          },
          "roundId": {
            ".write": "auth != null && auth.uid === data.parent().child('hostUid').val()",
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "chancellorUidLast": {
            ".write": "auth != null && auth.uid === data.parent().child('hostUid').val()"
          },
          "specialElectionReturnUid": {
            ".write": "auth != null && auth.uid === data.parent().child('hostUid').val()"
          },
          "investigatedUids": {
            ".write": "auth != null && auth.uid === data.parent().child('hostUid').val()"
          },
          "executionTarget": {
            ".write": "auth != null && ((auth.uid === data.parent().child('presidentUid').val() && !data.exists()) || auth.uid === data.parent().child('hostUid').val())"
          },
          "specialElectionTarget": {
            ".write": "auth != null && ((auth.uid === data.parent().child('presidentUid').val() && !data.exists()) || auth.uid === data.parent().child('hostUid').val())"
          },
          "investigateTarget": {
            ".write": "auth != null && ((auth.uid === data.parent().child('presidentUid').val() && !data.exists()) || auth.uid === data.parent().child('hostUid').val())"
          }
        },

        "players": {
          ".read": "auth != null",
          "$uid": {
            "name": {
              ".write": "auth != null && auth.uid === $uid"
            },
            "connected": {
              ".write": "auth != null && auth.uid === $uid"
            },
            "joinedAt": {
              ".write": "auth != null && auth.uid === $uid && !data.exists()"
            },
            "roleSeen": {
              ".write": "auth != null && (auth.uid === $uid || auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val())",
              ".validate": "newData.isBoolean()"
            },
            "alive": {
              ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()"
            },
            "retired": {
              ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()"
            }
          }
        },

        "reclaimRequests": {
          ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()",
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val())",
            ".write": "auth != null && auth.uid === $uid && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists()))",
            "status": {
              ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()"
            }
          }
        },

        "votes": {
          ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()",
          "$roundId": {
            ".read": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()",
            "$uid": {
              ".read": "auth != null && root.child('games').child($roomId).child('votesRevealed').child($roundId).val() === true",
              ".write": "auth != null && auth.uid === $uid && !data.exists() && (newData.val() === 'ja' || newData.val() === 'nein')"
            }
          }
        },
        "votesCast": {
          ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()",
          "$roundId": {
            ".read": "auth != null",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists()"
            }
          }
        },
        "votesRevealed": {
          ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()",
          "$roundId": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()"
          }
        },

        "secret": {
          "roles": {
            ".read": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()",
            ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()",
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val() && !data.exists()"
            }
          },
          "knownTeammates": {
            ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()",
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val() && !data.exists()"
            }
          },
          "reconnectPins": {
            ".read": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()",
            ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()",
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && ((auth.uid === $uid && !data.exists()) || auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val())",
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)"
            }
          },
          "deck": {
            ".read": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()",
            ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()"
          },
          "claims": {
            ".read": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()",
            ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()",
            "$key": {
              ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()"
            }
          },
          "discard": {
            ".read": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()",
            ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()"
          },
          "legislative": {
            ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()",
            "$roundId": {
              "presidentDraw": {
                ".read": "auth != null && (auth.uid === root.child('games').child($roomId).child('meta').child('presidentUid').val() || auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val())",
                ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()"
              },
              "presidentDiscardIdx": {
                ".read": "auth != null && (auth.uid === root.child('games').child($roomId).child('meta').child('presidentUid').val() || auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val())",
                ".write": "auth != null && ((auth.uid === root.child('games').child($roomId).child('meta').child('presidentUid').val() && !data.exists() && newData.isNumber() && newData.val() >= -1 && newData.val() <= 2) || auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val())"
              },
              "chancellorHand": {
                ".read": "auth != null && (auth.uid === root.child('games').child($roomId).child('meta').child('chancellorUid').val() || auth.uid === root.child('games').child($roomId).child('meta').child('presidentUid').val() || auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val())",
                ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()"
              },
              "chancellorEnactIdx": {
                ".read": "auth != null && (auth.uid === root.child('games').child($roomId).child('meta').child('chancellorUid').val() || auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val())",
                ".write": "auth != null && ((auth.uid === root.child('games').child($roomId).child('meta').child('chancellorUid').val() && !data.exists() && newData.isNumber() && newData.val() >= 0 && newData.val() <= 1) || auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val())"
              },
              "enactedTile": {
                ".read": "auth != null",
                ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val() && (newData.val() === 'liberal' || newData.val() === 'fascist')"
              },
              "vetoUsed": {
                ".read": "auth != null && (auth.uid === root.child('games').child($roomId).child('meta').child('presidentUid').val() || auth.uid === root.child('games').child($roomId).child('meta').child('chancellorUid').val() || auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val())",
                ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()"
              },
              "vetoRequested": {
                ".read": "auth != null && (auth.uid === root.child('games').child($roomId).child('meta').child('presidentUid').val() || auth.uid === root.child('games').child($roomId).child('meta').child('chancellorUid').val() || auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val())",
                ".write": "auth != null && ((auth.uid === root.child('games').child($roomId).child('meta').child('chancellorUid').val() && !data.exists() && newData.val() === true && root.child('games').child($roomId).child('secret').child('legislative').child($roundId).child('vetoUsed').val() !== true) || auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val())"
              },
              "vetoDecision": {
                ".read": "auth != null && (auth.uid === root.child('games').child($roomId).child('meta').child('presidentUid').val() || auth.uid === root.child('games').child($roomId).child('meta').child('chancellorUid').val() || auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val())",
                ".write": "auth != null && ((auth.uid === root.child('games').child($roomId).child('meta').child('presidentUid').val() && !data.exists() && (newData.val() === 'agreed' || newData.val() === 'refused')) || auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val())"
              }
            }
          },
          "executive": {
            ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()",
            "$roundId": {
              "investigateResult": {
                ".read": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('presidentUid').val()",
                ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val() && (newData.val() === 'liberal' || newData.val() === 'fascist')"
              },
              "policyPeek": {
                ".read": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('presidentUid').val()",
                ".write": "auth != null && auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val()"
              },
              "policyPeekSeen": {
                ".read": "auth != null && (auth.uid === root.child('games').child($roomId).child('meta').child('presidentUid').val() || auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val())",
                ".write": "auth != null && ((auth.uid === root.child('games').child($roomId).child('meta').child('presidentUid').val() && !data.exists()) || auth.uid === root.child('games').child($roomId).child('meta').child('hostUid').val())"
              }
            }
          }
        }
      }
    }
  }
}
